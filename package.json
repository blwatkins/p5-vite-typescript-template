{
  "name": "p5-vite-typescript-template",
  "license": "MIT",
  "private": true,
  "description": "A template project for using p5.js with TypeScript and Vite.",
  "author": {
    "name": "Brittni Watkins",
    "url": "https://blwatkins.github.io/"
  },
  "homepage": "https://github.com/blwatkins/p5-vite-typescript-template#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/blwatkins/p5-vite-typescript-template.git"
  },
  "bugs": {
    "url": "https://github.com/blwatkins/p5-vite-typescript-template/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.23.0 || >=24"
  },
  "scripts": {
    "lint:js": "eslint -c eslint.config.js.mjs .",
    "lint:ts": "eslint -c eslint.config.ts.mjs .",
    "lint:all": "npm run lint:js && npm run lint:ts",
    "build": "exit 1",
    "build:dev": "exit 1",
    "build:check": "npm run build:dev && npm run build",
    "serve": "exit 1",
    "dev": "exit 1",
    "test": "echo \"Error: no test specified\" && exit 1",
    "validate": "npm run lint:all && npm run build:check"
  },
  "dependencies": {
    "p5": "^2.3.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.8.1",
    "eslint-plugin-es-x": "^10.0.0",
    "globals": "^17.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  }
}
